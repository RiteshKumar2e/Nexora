# ─────────────────────────────────────────────────────────────
# Nexora environment. Copy to `.env` and adjust as needed.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- App ---
APP_NAME=Nexora
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:3000

# --- Ports (host side) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434

# --- Postgres (pgvector) ---
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora
POSTGRES_DB=nexora
# Used when running the backend OUTSIDE docker (points at localhost).
# docker-compose overrides this to the `db` service host automatically.
DATABASE_URL=postgresql+asyncpg://nexora:nexora@localhost:5432/nexora

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Local LLM (Ollama, OpenAI-compatible) ---
# When running the backend outside docker, this is localhost.
OLLAMA_BASE_URL=http://localhost:11434
# Default chat model. Pull it first:  ollama pull qwen3:8b
LLM_MODEL=qwen3:8b
# Generation defaults
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT=300

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
